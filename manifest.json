{
  "manifest_version": 3,
  "name": "Saipos - Confirmação de Impressão",
  "version": "1.3.2",
  "description": "Configura automaticamente todas as confirmações da Saipos para Sempre Imprimir neste computador.",
  "author": "math7x",
  "permissions": ["tabs"],
  "host_permissions": [
    "https://conta.saipos.com/*",
    "https://*.saipos.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://conta.saipos.com/*",
        "https://*.saipos.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Configurar impressão da Saipos",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
